generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums para o Ministério do Interior
enum MemberRank {
  GUARDA
  SEGUNDO_CABO
  PRIMEIRO_CABO
  SARGENTO
  SARGENTO_PRINCIPAL
  SUBINSPECTOR
  INSPECTOR
  INSPECTOR_PRINCIPAL
  ADJUNTO_SUPERINTENDENTE
  SUPERINTENDENTE
  SUPERINTENDENTE_PRINCIPAL
  PRIMEIRO_ADJUNTO_COMISSARIO
  COMISSARIO
  INSPECTOR_GERAL
}

enum Department {
  POLICIA_PROTECAO
  POLICIA_TRANSITO
  POLICIA_FRONTEIRAS
  POLICIA_COSTEIRA_LACUSTRE_FLUVIAL
  UNIDADE_CANINA
  UNIDADE_INTERVENCAO_RAPIDA
  UNIDADE_PROTECAO_ALTAS_INDIVIDUALIDADES
  GRUPO_OPERACOES_ESPECIAIS
}

enum UnitType {
  DIRECCAO_NACIONAL
  COMANDO_PROVINCIAL
  COMANDO_DISTRITAL
  ESQUADRA
  QUARTEL
  SUBUNIDADE
  DEPARTAMENTO
  SECCAO
  COMPANHIA
}

enum HierarchyNodeStatus {
  ACTIVE
  INACTIVE
  PLANNED
  UNDER_CONSTRUCTION
  DECOMMISSIONED
}

enum SecurityLevel {
  BASICO
  INTERMEDIO
  ALTO
  MAXIMO
  ADMINISTRATIVO
}

enum MaritalStatus {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
}

// Enums para o módulo Admin
enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminLevel {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum AdminModule {
  USERS
  HIERARCHY
  MEMBERS
  NOTIFICATIONS
  SYSTEM
  LOGS
  SETTINGS
}

enum AdminAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
}

enum ActivityLevel {
  INFO
  WARNING
  ERROR
  SECURITY
}

enum ActivityModule {
  AUTH
  USERS
  HIERARCHY
  NOTIFICATIONS
  SYSTEM
  ADMIN
}

enum TargetType {
  USER
  NODE
  MEMBER
  NOTIFICATION
  SYSTEM
  POST
  COMMENT
}

enum SettingsCategory {
  GENERAL
  SECURITY
  NOTIFICATIONS
  BACKUP
  MAINTENANCE
}

enum SettingsType {
  BOOLEAN
  NUMBER
  STRING
  SELECT
  JSON
}

// Enums para o módulo de configurações
enum UserSettingCategory {
  NOTIFICATIONS
  PRIVACY
  SECURITY
  APPEARANCE
  ACCOUNT
  PREFERENCES
  SYSTEM
}

enum UserSettingType {
  BOOLEAN
  NUMBER
  STRING
  SELECT
  JSON
  ARRAY
}

// Módulo de Ajuda (Help)
enum HelpCategory {
  GERAL
  AUTENTICACAO
  PERFIL
  HIERARQUIA
  MEMBROS
  NOTIFICACOES
  CONFIGURACOES
  SOCIAL
  ADMINISTRACAO
  SEGURANCA
}

enum HelpType {
  MANUAL
  TUTORIAL
  FAQ
  VIDEO
  GUIA_RAPIDO
  ARTIGO
}

enum HelpStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
  EM_REVISAO
}

enum HelpAudience {
  TODOS_USUARIOS
  MEMBROS
  COMANDANTES
  ADMINISTRADORES
  NOVOS_USUARIOS
}

enum AboutModuleStatus {
  ACTIVE
  MAINTENANCE
  DEPRECATED
}

enum AboutModuleCategory {
  CORE
  ADMIN
  SOCIAL
  HIERARCHY
  HELP
  SYSTEM
}

